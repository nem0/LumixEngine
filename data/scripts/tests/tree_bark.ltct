import "core:texture_recipe"
import "core:vec2"
import "core:vec4"
import "std:math" as math

const SIZE : u32 = 512;
const RIDGES : f32 = 19;

struct BarkFields {
    flow : Image;
    chips : Image;
}

fn knot(u : f32, v : f32, cx : f32, cy : f32) : f32 {
    const dx = (u - cx) * 8;
    const dy = (v - cy) * 16;
    const radius = math.sqrt(dx * dx + dy * dy);
    if radius >= 1 { return 0; }
    return math.sin(radius * 24) * (1 - radius) * 0.17;
}

fn main() : Texture2D {
    // Stretch a small noise field vertically to bend the long bark ridges.
    var flow = resize(gradientNoise(128, 16, 7), SIZE, SIZE);
    var chips = resize(cellNoise(128, 48, 18, 0.3), SIZE, SIZE);
    var height = create(SIZE, SIZE, 1);
    mapWith(height, BarkFields {flow, chips},
        fn(x : u32, y : u32, value : Vec4, fields : BarkFields) : Vec4 {
            const u = x as f32 / SIZE as f32;
            const v = y as f32 / SIZE as f32;
            const bend = getPixel(fields.flow, x, y).x;
            const chip = getPixel(fields.chips, x, y).x;
            const phase = (u * RIDGES + bend * 1.8) * 6.2831853;
            const ridge = math.pow(0.5 + 0.5 * math.sin(phase), 0.65);
            var relief = ridge * 0.7 + chip * 0.2;

            // Break up the raised plates with short cross-cracks.
            const cross = recipeAbs(math.sin(v * 210 + bend * 17));
            if cross < 0.055 and ridge > 0.45 and chip < 0.5 { relief *= 0.4; }
            if chip < 0.12 { relief *= 0.65; }
            relief += knot(u, v, 0.24, 0.31);
            relief += knot(u, v, 0.71, 0.62);
            relief += knot(u, v, 0.44, 0.86);
            return Vec4 {recipeClamp(relief), 0, 0, 1};
        });

    var palette : [5]ColorStop = [
        ColorStop {0, Vec4 {0.035, 0.018, 0.011, 1}},
        ColorStop {0.16, Vec4 {0.105, 0.055, 0.026, 1}},
        ColorStop {0.4, Vec4 {0.25, 0.14, 0.065, 1}},
        ColorStop {0.7, Vec4 {0.42, 0.29, 0.16, 1}},
        ColorStop {1, Vec4 {0.62, 0.49, 0.31, 1}}
    ];
    var albedo = gradientMap(height, palette);
    shade(albedo, height, 2.8,
        ReliefLight {Vec2 {1.1, -0.45}, 0.9, 0.35, 1.675});
    var grain = valueNoise(SIZE, SIZE, 9127);
    mapWith(albedo, grain,
        fn(x : u32, y : u32, value : Vec4, noise : Image) : Vec4 {
            const gain = 0.88 + getPixel(noise, x, y).x * 0.24;
            return Vec4 {
                recipeClamp(value.x * gain),
                recipeClamp(value.y * gain),
                recipeClamp(value.z * gain),
                1
            };
        });
    return texture2D(albedo);
}
