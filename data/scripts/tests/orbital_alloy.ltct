import "core:texture_recipe"
import "core:vec2"
import "core:vec4"
import "std:math" as math

comptime SIZE = 256;
comptime PANEL = 64;

fn panelHeight(x : u32, y : u32) : f32 {
    const px = (x % PANEL) as f32;
    const py = (y % PANEL) as f32;
    const edge = math.min(math.min(px, 63 - px), math.min(py, 63 - py));
    var height = recipeClamp((edge - 2) / 5) * 0.75;

    // Recessed vent slots across each panel's lower half.
    if px > 15 and px < 49 and py > 35 and py < 54 and (y % 7) < 3 {
        height *= 0.35;
    }

    // Four raised screw heads, each with a horizontal driver slot.
    const sx = math.min(math.abs(px - 10), math.abs(px - 53));
    const sy = math.min(math.abs(py - 10), math.abs(py - 53));
    if sx * sx + sy * sy < 9 {
        height = 0.95;
        if sy < 0.7 { height = 0.55; }
    }
    return height;
}

struct Finish {
    wear : Image;
    glow : Image;
}

fn main() : Texture2D {
    var height = create(SIZE, SIZE, 1);
    map(height,
        fn(x : u32, y : u32, value : Vec4) : Vec4 {
            return Vec4 {panelHeight(x, y), 0, 0, 1};
        });
    var palette : [4]ColorStop = [
        ColorStop {0, Vec4 {0.018, 0.026, 0.035, 1}},
        ColorStop {0.25, Vec4 {0.07, 0.10, 0.13, 1}},
        ColorStop {0.75, Vec4 {0.27, 0.34, 0.40, 1}},
        ColorStop {1, Vec4 {0.55, 0.64, 0.68, 1}}
    ];
    var albedo = gradientMap(height, palette);
    map(albedo,
        fn(x : u32, y : u32, value : Vec4) : Vec4 {
            const px = x % PANEL;
            const py = y % PANEL;
            var result = value;
            if ((x / PANEL + y / PANEL) % 2) == 0 { result *= 0.8; }
            if px > 6 and px < 58 and py > 22 and py < 29 {
                if ((x + y) / 6) % 2 == 0 { result = Vec4 {0.92, 0.49, 0.06, 1}; }
                else { result = Vec4 {0.045, 0.05, 0.055, 1}; }
            }
            result.w = 1;
            return result;
        });
    shade(albedo, height, 3,
        ReliefLight {Vec2 {1.15, -0.7}, 0.9, 0.3, 1.65});
    var conduits = create(SIZE, SIZE, 1);
    map(conduits,
        fn(x : u32, y : u32, value : Vec4) : Vec4 {
            var glow : f32 = 0;
            if (x % PANEL) < 2 or (y % PANEL) < 2 { glow = 1; }
            return Vec4 {glow, 0, 0, 1};
        });
    blur(conduits, 4);
    var finish = Finish {valueNoise(SIZE, SIZE, 417), conduits};
    mapWith(albedo, finish,
        fn(x : u32, y : u32, value : Vec4, state : Finish) : Vec4 {
            const grain = 0.92 + getPixel(state.wear, x, y).x * 0.16;
            const glow = getPixel(state.glow, x, y).x;
            return Vec4 {
                recipeClamp(value.x * grain + glow * 0.025),
                recipeClamp(value.y * grain + glow * 0.48),
                recipeClamp(value.z * grain + glow * 0.65),
                1
            };
        });
    return texture2D(albedo);
}
