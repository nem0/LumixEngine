import "core:texture_recipe"
import "core:vec2"
import "core:vec4"
import "std:math" as math

const SIZE : u32 = 256;

fn main() : Texture2D {
    // Distort the mineral cells, then pick out narrow luminous contours.
    var distortion = resize(gradientNoise(64, 64, 5), SIZE, SIZE);
    var stone = cellNoise(SIZE, SIZE, 9, 0.7);
    warp(stone, distortion, 42);
    twirl(stone, 0.8);
    var height = copy(stone);
    map(height,
        fn(x : u32, y : u32, value : Vec4) : Vec4 {
            const bands = math.sin(value.x * 32);
            const vein = math.pow(math.abs(bands), 12);
            return Vec4 {recipeClamp(value.x * 0.55 + vein * 0.35), 0, 0, 1};
        });

    var palette : [5]ColorStop = [
        ColorStop {0, Vec4 {0.012, 0.025, 0.045, 1}},
        ColorStop {0.25, Vec4 {0.025, 0.13, 0.18, 1}},
        ColorStop {0.5, Vec4 {0.055, 0.36, 0.39, 1}},
        ColorStop {0.72, Vec4 {0.38, 0.65, 0.55, 1}},
        ColorStop {1, Vec4 {0.9, 0.73, 0.38, 1}}
    ];
    var albedo = gradientMap(height, palette);
    shade(albedo, height, 3.2,
        ReliefLight {Vec2 {1.3, -0.65}, 0.85, 0.25, 1.6});

    mapWith(albedo, stone,
        fn(x : u32, y : u32, value : Vec4, field : Image) : Vec4 {
            const mineral = getPixel(field, x, y).x;
            const vein = math.pow(math.abs(math.sin(mineral * 32)), 28);
            const warm = recipeClamp((mineral - 0.42) * 3);
            const emission = Vec4 {0.05 + warm * 0.8, 0.75 - warm * 0.3, 0.85 - warm * 0.75, 0};
            return Vec4 {
                recipeClamp(value.x + emission.x * vein * 0.8),
                recipeClamp(value.y + emission.y * vein * 0.8),
                recipeClamp(value.z + emission.z * vein * 0.8),
                1
            };
        });
    return texture2D(albedo);
}
