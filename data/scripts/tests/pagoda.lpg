// Procedural two tier pavilion: a stone slab with a stepped wooden plinth, an open
// ground floor on round columns, a latticed upper storey, two green tiled hip roofs
// with swept up corners, wooden ridges and a stacked finial. Units are meters.
// Cylinders are built along Z and turned to stand along Y; roofs are generated as
// height fields, one grid per side so the tile rows follow the eaves.
import "core:procedural_geom"
import "core:vec2" as vec2
import "core:vec3" as vec3
import "std:math" as math

comptime GRID = 18;
comptime RIDGE_STEPS = 24;

// pagoda.ltct is a 2 x 2 atlas; every part maps its UVs into one of the regions.
// Columns/rows: (0, 0) cream panels, (1, 0) wood, (0, 1) roof tiles, (1, 1) stone.
fn region(mesh : Mesh, cx : f32, cy : f32) : Mesh {
    for i in 0..mesh.vertices.size {
        const uv = mesh.vertices.values[i].uv;
        mesh.vertices.values[i].uv = vec2.Vec2 { (cx + 0.02 + uv.x * 0.96) * 0.5, (cy + 0.02 + uv.y * 0.96) * 0.5 };
    }
    return mesh;
}

fn panel(mesh : Mesh) : Mesh { return region(mesh, 0.0, 0.0); }
fn wood(mesh : Mesh) : Mesh { return region(mesh, 1.0, 0.0); }
fn tiles(mesh : Mesh) : Mesh { return region(mesh, 0.0, 1.0); }
fn stone(mesh : Mesh) : Mesh { return region(mesh, 1.0, 1.0); }

fn upright(mesh : Mesh, y : f32) : Mesh {
    return translate(rotate(mesh, vec3.Vec3 { -math.pi * 0.5, 0.0, 0.0 }), vec3.Vec3 { 0.0, y, 0.0 });
}

fn box(width : f32, height : f32, depth : f32, x : f32, y : f32, z : f32) : Mesh {
    return translate(cube(width, height, depth), vec3.Vec3 { x, y, z });
}

// Turns a point or direction in the plan by side * 90 degrees around Y.
fn turn(side : i32, x : f32, z : f32) : vec3.Vec3 {
    if side == 1 { return vec3.Vec3 { -z, 0.0, x }; }
    if side == 2 { return vec3.Vec3 { -x, 0.0, -z }; }
    if side == 3 { return vec3.Vec3 { z, 0.0, -x }; }
    return vec3.Vec3 { x, 0.0, z };
}

// Roof surface above a square of half width h: `top` at the center, a concave
// sweep toward the eaves and corners that curl up.
fn roofHeight(x : f32, z : f32, h : f32, top : f32) : f32 {
    const ax = math.abs(x) / h;
    const az = math.abs(z) / h;
    const s = 1.0 - math.max(ax, az);
    const corner = ax * az;
    comptime lift = 0.95;
    return top * s * s + lift * corner * corner * corner;
}

// One side of a hip roof: rows of vertices running parallel to the eave.
fn roofSide(m : *Mesh, side : i32, h : f32, top : f32) : void {
    comptime n = GRID;
    comptime eps = 0.01;
    const first = m.vertices.size as u32;
    for j in 0..(n + 1) {
        const t = (j as f32) / (n as f32);
        const d = 1.0 - t;
        for i in 0..(n + 1) {
            const a = (i as f32) / (n as f32) * 2.0 - 1.0;
            const x = a * d * h;
            const z = d * h;
            const dx = (roofHeight(x + eps, z, h, top) - roofHeight(x - eps, z, h, top)) / (2.0 * eps);
            const dz = (roofHeight(x, z + eps, h, top) - roofHeight(x, z - eps, h, top)) / (2.0 * eps);
            const p = turn(side, x, z);
            const nn = turn(side, -dx, -dz);
            const tt = turn(side, 1.0, 0.0);
            vertex(m, vec3.Vec3 { p.x, roofHeight(x, z, h, top), p.z },
                vec3.normalizeSafe(vec3.Vec3 { nn.x, 1.0, nn.z }),
                vec3.normalizeSafe(vec3.Vec3 { tt.x, dx, tt.z }),
                a * d * 0.5 + 0.5, t);
        }
    }
    for j in 0..n {
        for i in 0..n {
            const a00 = first + (j * (n + 1) + i) as u32;
            const a10 = a00 + 1;
            const a01 = a00 + (n + 1) as u32;
            triangle(m, a00, a10, a01);
            triangle(m, a10, a01 + 1, a01);
        }
    }
}

// Wooden fascia along the curved eaves: outer face, top and underside. The sides are
// pushed out by the fascia offset so the four of them meet exactly at the corners.
fn fascia(m : *Mesh, h : f32, top : f32) : void {
    comptime n = GRID * 2;
    comptime thickness = 0.2;
    comptime out = 0.04;       // how far the fascia sticks out past the roof edge
    comptime depth = 0.12;     // how far the top and underside reach under the roof
    for side in 0..4 {
        const outer = m.vertices.size as u32;
        for i in 0..(n + 1) {
            const a = (i as f32) / (n as f32) * 2.0 - 1.0;
            const y = roofHeight(a * h, h, h, top);
            const p = turn(side, a * (h + out), h + out);
            const nn = turn(side, 0.0, 1.0);
            const tt = turn(side, 1.0, 0.0);
            const u = (i as f32) / (n as f32);
            vertex(m, vec3.Vec3 { p.x, y - thickness, p.z }, vec3.Vec3 { nn.x, 0.0, nn.z }, vec3.Vec3 { tt.x, 0.0, tt.z }, u, 0.0);
            vertex(m, vec3.Vec3 { p.x, y + 0.02, p.z }, vec3.Vec3 { nn.x, 0.0, nn.z }, vec3.Vec3 { tt.x, 0.0, tt.z }, u, 1.0);
        }
        for i in 0..n {
            const bl = outer + (i * 2) as u32;
            triangle(m, bl, bl + 2, bl + 1);
            triangle(m, bl + 2, bl + 3, bl + 1);
        }

        // top face and underside (outer edge, then an inner edge under the roof)
        const caps = m.vertices.size as u32;
        for i in 0..(n + 1) {
            const a = (i as f32) / (n as f32) * 2.0 - 1.0;
            const y = roofHeight(a * h, h, h, top);
            const po = turn(side, a * (h + out), h + out);
            const pi = turn(side, a * (h - depth), h - depth);
            const tt = turn(side, 1.0, 0.0);
            const u = (i as f32) / (n as f32);
            const up = vec3.Vec3 { 0.0, 1.0, 0.0 };
            const down = vec3.Vec3 { 0.0, -1.0, 0.0 };
            const t3 = vec3.Vec3 { tt.x, 0.0, tt.z };
            vertex(m, vec3.Vec3 { po.x, y + 0.02, po.z }, up, t3, u, 1.0);
            vertex(m, vec3.Vec3 { pi.x, y + 0.02, pi.z }, up, t3, u, 1.0);
            vertex(m, vec3.Vec3 { po.x, y - thickness, po.z }, down, t3, u, 0.0);
            vertex(m, vec3.Vec3 { pi.x, y - thickness, pi.z }, down, t3, u, 0.0);
        }
        for i in 0..n {
            const c0 = caps + (i * 4) as u32;
            const c1 = c0 + 4;
            // top: outer(i), outer(i + 1), inner(i) is counterclockwise seen from above
            triangle(m, c0, c1, c0 + 1);
            triangle(m, c1, c1 + 1, c0 + 1);
            // underside: the opposite winding
            triangle(m, c0 + 2, c0 + 3, c1 + 2);
            triangle(m, c1 + 2, c0 + 3, c1 + 3);
        }
    }
}

// Wooden bands along the four hip ridges.
fn ridges(m : *Mesh, h : f32, top : f32) : void {
    comptime w = 0.09;
    for c in 0..4 {
        const sx : f32 = (c % 2 == 0) ? 1.0 : -1.0;
        const sz : f32 = (c < 2) ? 1.0 : -1.0;
        const first = m.vertices.size as u32;
        for k in 0..(RIDGE_STEPS + 1) {
            const d = 0.97 * (1.0 - (k as f32) / (RIDGE_STEPS as f32));   // stops just short of the corner tip
            const x = sx * d * h;
            const z = sz * d * h;
            const y = roofHeight(x, z, h, top) + 0.05;
            vertex(m, vec3.Vec3 { x + sz * w, y, z - sx * w }, vec3.Vec3 { 0.0, 1.0, 0.0 }, vec3.Vec3 { -sx, 0.0, -sz }, 0.0, d);
            vertex(m, vec3.Vec3 { x - sz * w, y, z + sx * w }, vec3.Vec3 { 0.0, 1.0, 0.0 }, vec3.Vec3 { -sx, 0.0, -sz }, 1.0, d);
        }
        for k in 0..RIDGE_STEPS {
            const l0 = first + (k * 2) as u32;
            triangle(m, l0, l0 + 2, l0 + 1);
            triangle(m, l0 + 1, l0 + 2, l0 + 3);
        }
    }
}

fn roof(h : f32, top : f32) : Mesh {
    var shingles = empty();
    for side in 0..4 { roofSide(&shingles, side, h, top); }
    var trim = empty();
    fascia(&trim, h, top);
    ridges(&trim, h, top);
    return merge(tiles(shingles), wood(trim));
}

// Round column on a square base with a capital.
fn column(height : f32, x : f32, z : f32) : Mesh {
    var c = wood(upright(cylinder(0.17, height, 14), 0.3 + height * 0.5));
    c = merge(c, wood(box(0.5, 0.3, 0.5, 0.0, 0.15, 0.0)));
    c = merge(c, wood(box(0.42, 0.2, 0.42, 0.0, 0.3 + height + 0.1, 0.0)));
    return translate(c, vec3.Vec3 { x, 0.0, z });
}

fn main() : Mesh {
    // stone slab and three wooden steps
    var p = stone(box(8.4, 0.12, 8.4, 0.0, 0.06, 0.0));
    p = merge(p, wood(box(7.0, 0.15, 7.0, 0.0, 0.195, 0.0)));
    p = merge(p, wood(box(6.5, 0.15, 6.5, 0.0, 0.345, 0.0)));
    p = merge(p, wood(box(6.0, 0.15, 6.0, 0.0, 0.495, 0.0)));
    comptime floor = 0.57;

    // open ground floor: 12 columns around the perimeter and a beam frame
    comptime colh = 2.2;
    comptime ring = 2.6;
    for i in 0..4 {
        const o = (-1.0 + (i as f32) * 2.0 / 3.0) * ring;
        p = merge(p, translate(column(colh, o, ring), vec3.Vec3 { 0.0, floor, 0.0 }));
        p = merge(p, translate(column(colh, o, -ring), vec3.Vec3 { 0.0, floor, 0.0 }));
    }
    for i in 1..3 {
        const o = (-1.0 + (i as f32) * 2.0 / 3.0) * ring;
        p = merge(p, translate(column(colh, ring, o), vec3.Vec3 { 0.0, floor, 0.0 }));
        p = merge(p, translate(column(colh, -ring, o), vec3.Vec3 { 0.0, floor, 0.0 }));
    }
    const beam_y : f32 = floor + 0.3 + colh + 0.2 + 0.15;
    p = merge(p, wood(box(ring * 2.0 + 0.5, 0.3, 0.3, 0.0, beam_y, ring)));
    p = merge(p, wood(box(ring * 2.0 + 0.5, 0.3, 0.3, 0.0, beam_y, -ring)));
    p = merge(p, wood(box(0.3, 0.3, ring * 2.0 + 0.5, ring, beam_y, 0.0)));
    p = merge(p, wood(box(0.3, 0.3, ring * 2.0 + 0.5, -ring, beam_y, 0.0)));

    // lower roof
    const roof1 : f32 = beam_y + 0.15;
    p = merge(p, translate(roof(3.9, 1.5), vec3.Vec3 { 0.0, roof1, 0.0 }));

    // upper storey: cream panels, corner posts and latticed windows
    const wall_y = roof1 + 0.4;
    comptime wall_h = 1.5;
    comptime half = 1.45;
    p = merge(p, wood(box(half * 2.0 + 0.2, 0.12, half * 2.0 + 0.2, 0.0, wall_y + 0.06, 0.0)));
    p = merge(p, panel(box(half * 2.0 - 0.1, wall_h, half * 2.0 - 0.1, 0.0, wall_y + 0.12 + wall_h * 0.5, 0.0)));
    for c in 0..4 {
        const sx : f32 = (c % 2 == 0) ? 1.0 : -1.0;
        const sz : f32 = (c < 2) ? 1.0 : -1.0;
        p = merge(p, wood(box(0.26, wall_h, 0.26, sx * half, wall_y + 0.12 + wall_h * 0.5, sz * half)));
    }
    for side in 0..4 {
        var bars = empty();
        for b in 0..5 {
            bars = merge(bars, box(0.05, 0.6, 0.06, -0.6 + (b as f32) * 0.3, 0.0, half - 0.03));
        }
        bars = merge(bars, box(1.5, 0.05, 0.07, 0.0, 0.3, half - 0.03));
        bars = merge(bars, box(1.5, 0.05, 0.07, 0.0, -0.3, half - 0.03));
        bars = rotate(bars, vec3.Vec3 { 0.0, (side as f32) * math.pi * 0.5, 0.0 });
        p = merge(p, translate(wood(bars), vec3.Vec3 { 0.0, wall_y + 0.12 + wall_h * 0.62, 0.0 }));
    }
    const top_beam : f32 = wall_y + 0.12 + wall_h;
    p = merge(p, wood(box(half * 2.0 + 0.3, 0.2, half * 2.0 + 0.3, 0.0, top_beam + 0.1, 0.0)));

    // upper roof and stacked finial
    const roof2 : f32 = top_beam + 0.2;
    p = merge(p, translate(roof(2.8, 1.2), vec3.Vec3 { 0.0, roof2, 0.0 }));
    const apex : f32 = roof2 + 1.2;
    p = merge(p, wood(box(0.46, 0.14, 0.46, 0.0, apex + 0.05, 0.0)));
    p = merge(p, wood(box(0.28, 0.4, 0.28, 0.0, apex + 0.3, 0.0)));
    p = merge(p, wood(box(0.4, 0.14, 0.4, 0.0, apex + 0.57, 0.0)));
    p = merge(p, wood(box(0.22, 0.3, 0.22, 0.0, apex + 0.79, 0.0)));
    return p;
}
