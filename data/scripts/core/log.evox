import "core:string"

extern fn logErrorString(v : []const u8) : void;
extern fn logInfoString(v : []const u8) : void;

fn logError(args : ...any) : void {
	for arg in args {
        match arg {
            case []const u8: logErrorString(arg);
			case i8: logErrorString(integerToString(arg).slice);
			case i16: logErrorString(integerToString(arg).slice);
			case i32: logErrorString(integerToString(arg).slice);
			case i64: logErrorString(integerToString(arg).slice);
			case u8: logErrorString(integerToString(arg).slice);
			case u16: logErrorString(integerToString(arg).slice);
			case u32: logErrorString(integerToString(arg).slice);
			case u64: logErrorString(integerToString(arg).slice);
            case: logErrorString("logError: UNSUPPORTED TYPE");
        }
    }
}


fn logInfo(args : ...any) : void {
    for arg in args {
        match arg {
            case []const u8: logInfoString(arg);
            case: logErrorString(" !UNSUPPORTED TYPE! ");
        }
    }
}
