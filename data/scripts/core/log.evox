extern fn logErrorString(v : []const u8) : void;
extern fn logInfoString(v : []const u8) : void;


fn logError(args : ...any) : void {
    for arg in args {
        match arg {
            case []const u8: logErrorString(arg);
            case: logErrorString(" !UNSUPPORTED TYPE! ");
        }
    }
}


fn logInfo(args : ...any) : void {
    for arg in args {
        match arg {
            case []const u8: logInfoString(arg);
            case: logErrorString(" !UNSUPPORTED TYPE! ");
        }
    }
}
