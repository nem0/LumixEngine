import "core:postprocess"
import "core:postprocess/atmo" as atmo
import "core:postprocess/ssao" as ssao
import "core:postprocess/dof" as dof
import "core:postprocess/bloom" as bloom
import "core:postprocess/taa" as taa
import "core:postprocess/film_grain" as film_grain

// The engine's default postprocesses. The `postprocess.evox` of a project (Studio creates one that registers all of them)
// decides what runs:
//
//     import "core:postprocess/defaults" as defaults
//
//     fn main(registry : Registry) : void {
//         defaults.register(registry);          // all of them, or call the functions below for individual ones
//         ...                                   // and add your own effects
//     }
//
// The order matters within a stage: DOF runs before bloom, as it always did. Register them in the order of `register`.

fn registerAtmosphere(registry : Registry) : void {
	var effect = postprocess();
	effect.beforeTransparent = atmo.atmo;
	registry.add(effect);
}

fn registerAmbientOcclusion(registry : Registry) : void {
	var effect = postprocess();
	effect.beforeLightPass = ssao.ssao;
	effect.debugUI = ssao.debugUI;
	registry.add(effect);
}

fn registerDepthOfField(registry : Registry) : void {
	var effect = postprocess();
	effect.beforeTonemap = dof.dof;
	registry.add(effect);
}

// bloom and the tonemapping with autoexposure that goes with it
fn registerBloom(registry : Registry) : void {
	var effect = postprocess();
	effect.beforeTonemap = bloom.bloom;
	effect.tonemap = bloom.bloomTonemap;
	effect.debugUI = bloom.debugUI;
	effect.debugOutput = bloom.debugOutput;
	registry.add(effect);
}

fn registerAntialiasing(registry : Registry) : void {
	var effect = postprocess();
	effect.antialias = taa.taa;
	effect.debugUI = taa.debugUI;
	registry.add(effect);
}

fn registerFilmGrain(registry : Registry) : void {
	var effect = postprocess();
	effect.afterTonemap = film_grain.filmGrain;
	registry.add(effect);
}

fn register(registry : Registry) : void {
	registerAtmosphere(registry);
	registerAmbientOcclusion(registry);
	registerDepthOfField(registry);
	registerBloom(registry);
	registerAntialiasing(registry);
	registerFilmGrain(registry);
}
