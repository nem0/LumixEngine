// use as an attribute, i.e. #[Data {}]
// can be attached to EvoxData component
struct Data {}

// system injects owning entity into field marked with #[Owner {}]
struct Owner {}

// example:
// #[Data{}]
// struct MyData {
//     #[Owner{}]
//     entity : Entity;
//     some_data : f32;
// }

// can be used as an attribute on global variable
// MapGlobal variables can be set in the editor
struct MapGlobal {}

// example:
// #[MapGlobal {}]
// var spawn_point : ?Entity = null;
