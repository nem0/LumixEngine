import "std:mem" as mem

struct Array[T] {
	data : []T;
	size : isize;
	capacity : isize;
}

fn init(array : ref Array[$T]) : void {
	array.size = 0;
	array.capacity = 0;
}

fn destroy(array : ref Array[$T]) : void {
	if array.capacity > 0 {
		mem.free(array.data as []byte);
	}
	array.data = null;
	array.size = 0;
	array.capacity = 0;
}

fn reserve(array : ref Array[$T], capacity : isize) : void {
	if capacity <= array.capacity {
		return;
	}

	var memory : []byte = mem.alloc(capacity * sizeof(T), alignof(T));
	var data : []T = memory as []T;
	var i : isize = 0;
	while i < array.size {
		data[i] = array.data[i];
		i += 1;
	}
	if array.capacity > 0 {
		mem.free(array.data as []byte);
	}
	array.data = data;
	array.capacity = capacity;
}

fn push(array : ref Array[$T], value : T) : void {
	if array.size == array.capacity {
		reserve(ref array, array.capacity * 2 + 4);
	}
	array.data[array.size] = value;
	array.size += 1;
}

fn get(array : Array[$T], index : isize) : T {
	return array.data[index];
}

fn set(array : ref Array[$T], index : isize, value : T) : void {
	array.data[index] = value;
}

fn slice(array : Array[$T]) : []T {
	return array.data[:array.size];
}
