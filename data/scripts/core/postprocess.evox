// import core:postprocess as postprocess
//
// Script postprocesses. The root script is `postprocess.evox` in the project root (compiled as a second root of `main.evox`, sharing its runtime). Every
// project has one, Studio creates it when it opens a project without one. It registers the engine's default postprocesses
// (atmosphere, SSAO, DOF, bloom, TAA, film grain) by calling core:postprocess/defaults, and the effects of the project. It defines
//
//     fn main(registry : Registry) : void
//
// which is called whenever the script is (re)loaded and registers the effects with `registry.add(effect)`.
// An effect is a set of optional hooks, mirroring the stages of the renderer. Hooks of the same stage run in
// registration order, each receiving the output of the previous one:
//
//     fn main(registry : Registry) : void {
//         defaults.register(registry);
//
//         var vignette = postprocess();
//         vignette.afterTonemap = myVignette;
//         registry.add(vignette);
//     }
//
// Hooks run for every pipeline (scene view, game view, ...), use `ctx.pipelineType()` to skip some. Global
// variables are shared by all hooks of all effects. A hook that fails is disabled until the script is reloaded.
// Hand-written, native side is in src/evox/evox_postprocess.cpp.

import "core:renderer/module"
import "core:renderer/pipelinetype"
import "core:renderer/gpu/textureformat"
import "core:imgui" as imgui

// Valid only during the call it was passed to, do not store it.
struct Registry { ptr : cptr; }
struct Context { ptr : cptr; }
struct Shader { ptr : cptr; }
struct RenderBuffer { handle : u32; }
// A GPU buffer (e.g. a histogram) that shaders access through bindless handles. Zero is invalid. Like render
// buffers, storage in `state` is destroyed automatically.
struct Storage { id : u32; }

// Hooks taking a buffer return the buffer the next stage should use: `input` (or an invalid buffer) when the
// image was modified in place or left as is, or a different buffer when the effect produced a new one.
// Ownership: if a hook returns a new buffer it also has to release `input` with `releaseBuffer`, except for
// `tonemap`, where the renderer releases `input` itself. The renderer owns (and releases) the returned buffer.
// Built-in effects run before scripts, so e.g. enabled TAA does antialiasing first and `antialias` hooks only
// run if no built-in did.
struct Postprocess {
	// before lighting, G-buffer is filled
	beforeLightPass : ?fn(Context) : void;
	// lit opaque scene, before transparent geometry is drawn
	beforeTransparent : ?fn(Context, RenderBuffer) : RenderBuffer;
	// return a valid buffer if antialiasing was done, it replaces the input and no other antialiasing runs
	antialias : ?fn(Context, RenderBuffer) : RenderBuffer;
	// HDR color before tonemapping
	beforeTonemap : ?fn(Context, RenderBuffer) : RenderBuffer;
	// return a valid buffer if tonemapping was done, it replaces the built-in tonemap
	tonemap : ?fn(Context, RenderBuffer) : RenderBuffer;
	// final color, before UI
	afterTonemap : ?fn(Context, RenderBuffer) : RenderBuffer;
	// Studio's Debug popup of a view, called with a context that has no input and no G-buffer. Draw ImGui widgets
	// (core:imgui) that edit the settings of the effect, and `debugRadio` to let the user show one of its buffers.
	// Do not create or release buffers here.
	debugUI : ?fn(Context) : void;
	// Called while the debug view shows this plugin, instead of the usual result of the pipeline. `output` is the image of
	// the pipeline: if `ctx.isDebugShown(name)` is true for one of the buffers of the effect, copy it to `output`
	// with `blit` and return true, otherwise return false.
	debugOutput : ?fn(Context, RenderBuffer) : bool;
}

// Registers a copy of the effect.
extern fn add(registry : Registry, effect : Postprocess) : void;

// An effect without any hooks, assign the ones you need.
fn postprocess() : Postprocess {
	return Postprocess {null, null, null, null, null, null, null, null};
}

// Zero is the invalid buffer, so a zero-initialized RenderBuffer (e.g. in `state`) is invalid.
fn invalidBuffer() : RenderBuffer {
	return RenderBuffer {0};
}

fn isValid(buffer : RenderBuffer) : bool {
	return buffer.handle != 0;
}

// Memory of type `T` that belongs to the pipeline the hook is running in. It is zero-initialized the first time and
// keeps its value between frames, so it's the place for history buffers and other per-pipeline data (globals are
// shared by all pipelines). Render buffers stored in it (directly or in nested structs/arrays) are released
// automatically when the pipeline is destroyed or the script reloaded. Do not keep the pointer after the hook returns.
extern fn stateRaw(ctx : Context, t : type) : []byte;
fn state(ctx : Context, T : comptime type) : *T {
	const raw = stateRaw(ctx, T);
	const items = raw as []T;
	return &items[0];
}

// Creates a render buffer of the given size that compute shaders can read and write. Release it with `releaseBuffer`
// when you don't need it anymore, unless it's stored in `state`, which releases it for you. Depth, compressed, sRGB
// and BGRA formats are not supported.
extern fn createBuffer(ctx : Context, width : u32, height : u32, format : TextureFormat) : RenderBuffer;
// Like `createBuffer`, but the buffer can also be a render target: it can be cleared with `clear` and drawn into with
// `setRenderTarget` and `draw`. Use it for buffers the renderer draws into after your hook, e.g. what `tonemap`
// returns. Prefer `createBuffer` otherwise, some formats (R32F) don't work as render targets.
extern fn createRenderTarget(ctx : Context, width : u32, height : u32, format : TextureFormat) : RenderBuffer;
extern fn releaseBuffer(ctx : Context, buffer : RenderBuffer) : void;
// Clears all channels of a buffer created with `createRenderTarget` with the given color.
extern fn clear(ctx : Context, buffer : RenderBuffer, r : f32, g : f32, b : f32, a : f32) : void;
// Copies (and converts the format of) a width x height region from src to dst.
extern fn blit(ctx : Context, src : RenderBuffer, dst : RenderBuffer, width : u32, height : u32) : void;

// color buffer entering this stage (does not change while the effects of a stage run, pass the result of the previous effect explicitly)
extern fn input(ctx : Context) : RenderBuffer;
// scene depth, not available in the `tonemap` hook
extern fn depth(ctx : Context) : RenderBuffer;
// The G-buffer textures, not available in the `tonemap` hook. The built-in effects use B for normals (and ambient
// occlusion), C for screen space shadowing (in .w) and D for motion vectors. Write to them with `rwBindless`.
extern fn gbufferRaw(ctx : Context, index : u32) : RenderBuffer;
fn gbufferA(ctx : Context) : RenderBuffer { return gbufferRaw(ctx, 0); }
fn gbufferB(ctx : Context) : RenderBuffer { return gbufferRaw(ctx, 1); }
fn gbufferC(ctx : Context) : RenderBuffer { return gbufferRaw(ctx, 2); }
fn gbufferD(ctx : Context) : RenderBuffer { return gbufferRaw(ctx, 3); }
extern fn renderModule(ctx : Context) : RenderModule;
extern fn pipelineType(ctx : Context) : PipelineType;
// viewport (render) size in pixels
extern fn width(ctx : Context) : u32;
extern fn height(ctx : Context) : u32;
// size of the image the pipeline presents, what upscalers and temporal antialiasing work with
extern fn displayWidth(ctx : Context) : u32;
extern fn displayHeight(ctx : Context) : u32;
// Shifts the camera by a sub-pixel offset that changes every frame, which temporal antialiasing needs. It applies from
// the next frame on, so a `antialias` hook that is not running should switch it off again.
extern fn enablePixelJitter(ctx : Context, enable : bool) : void;
// false while temporal antialiasing is switched off, e.g. because an upscaler (DLSS, FSR3) does the antialiasing
extern fn builtinTaaEnabled(ctx : Context) : bool;

// Loaded once and cached, `path` is relative to the project, e.g. "engine/shaders/film_grain.hlsl".
extern fn loadShader(ctx : Context, path : []const u8) : Shader;
extern fn isReady(shader : Shader) : bool;

// Bindless handles to put into uniform data. Use `rwBindless` for buffers the shader writes to.
extern fn bindless(ctx : Context, buffer : RenderBuffer) : u32;
extern fn rwBindless(ctx : Context, buffer : RenderBuffer) : u32;

// profiler / graphics debugger scope
extern fn beginBlock(ctx : Context, name : []const u8) : void;
extern fn endBlock(ctx : Context) : void;

extern fn dispatchRaw(ctx : Context, shader : Shader, define : []const u8, uniform : []const byte, x : u32, y : u32, z : u32) : void;
extern fn drawRaw(ctx : Context, shader : Shader, define : []const u8, uniform : []const byte) : void;

// Dispatches a compute shader. `uniform` is copied to the shader's `Drawcall` constant buffer (b4), its layout
// must match the cbuffer in HLSL. Does nothing until the shader is compiled. `define` selects a variant of the shader
// (an empty string for none). The renderer inserts the memory barriers for buffers whose `rwBindless` handle you
// asked for before the dispatch, so request it again for every dispatch that writes the buffer.
fn dispatchDefine(ctx : Context, shader : Shader, define : []const u8, uniform : $T, x : u32, y : u32, z : u32) : void {
	var storage : [1]T = undefined;
	storage[0] = uniform;
	const items : []T = storage;
	dispatchRaw(ctx, shader, define, items as []byte, x, y, z);
}

fn dispatch(ctx : Context, shader : Shader, uniform : $T, x : u32, y : u32, z : u32) : void {
	dispatchDefine(ctx, shader, "", uniform, x, y, z);
}

// Draws a fullscreen triangle into the render target set by `setRenderTarget`. The shader has to be a surface shader
// (`//@surface`) with `mainVS` and `mainPS`. Does nothing until the shader is compiled.
fn drawDefine(ctx : Context, shader : Shader, define : []const u8, uniform : $T) : void {
	var storage : [1]T = undefined;
	storage[0] = uniform;
	const items : []T = storage;
	drawRaw(ctx, shader, define, items as []byte);
}

fn draw(ctx : Context, shader : Shader, uniform : $T) : void {
	drawDefine(ctx, shader, "", uniform);
}

// Makes `buffer` (created with `createRenderTarget`) the target of the following `draw` calls.
extern fn setRenderTarget(ctx : Context, buffer : RenderBuffer) : void;

// GPU buffers of `size` bytes. Their contents are undefined until written. Release one with `releaseStorage`
// unless it's stored in `state`.
extern fn createStorage(ctx : Context, size : u32) : Storage;
extern fn releaseStorage(ctx : Context, storage : Storage) : void;
// Bindless handles to put into uniform data, `bindlessStorage` to read the buffer, `rwBindlessStorage` to write it.
extern fn bindlessStorage(ctx : Context, storage : Storage) : u32;
extern fn rwBindlessStorage(ctx : Context, storage : Storage) : u32;

// Debug view. A `debugUI` hook offers buffers with `debugRadio`, the `debugOutput` hook of the same effect checks
// `isDebugShown` with the same name and copies the buffer to its `output`. The debug view is per pipeline (scene view, game
// view), names only need to be unique among the effects.
extern fn showDebug(ctx : Context, name : []const u8) : void;
extern fn isDebugShown(ctx : Context, name : []const u8) : bool;

// A radio button that switches the debug view to the buffer `name`. Call it from `debugUI`.
fn debugRadio(ctx : Context, name : []const u8) : void {
	if imgui.radioButton(name, ctx.isDebugShown(name)) {
		ctx.showDebug(name);
	}
}
