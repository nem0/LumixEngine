// import core:sentry as sentry

// Blocks until the upload ends, returns false on failure.
// email can be empty. attachment_paths can be empty, it can contain at most 8 files, each any file on
// disk (at most 5 MiB; a .log over that is cut to its last 5 MiB), uploaded as is.
extern fn sendFeedback(message : []const u8, email : []const u8, attachment_paths : []const []const u8) : bool;
