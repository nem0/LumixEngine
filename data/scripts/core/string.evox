// Compares strings lexicographically, returning a negative value, zero, or a
// positive value when left is less than, equal to, or greater than right.
fn strcmp(left : []const u8, right : []const u8) : i32 {
	const count = left.length < right.length ? left.length : right.length;
	for i in 0..count {
		if left[i] < right[i] { return -1; }
		if left[i] > right[i] { return 1; }
	}
	if left.length < right.length { return -1; }
	if left.length > right.length { return 1; }
	return 0;
}

fn endsWith(value : []const u8, suffix : []const u8) : bool {
	if value.length < suffix.length {
		return false;
	}
	const offset = value.length - suffix.length;
	for i in 0..suffix.length {
		if value[offset + i] != suffix[i] {
			return false;
		}
	}
	return true;
}

enum ParseError {
    NotANumber,
    Overeflow
}

// parse string until not a number character is encountered
// var a : u64 = parseU64(text) else return;
fn parseU64(a : []const u8) : union { u64, ParseError } {
    var len = a.length;
    if len < 1 { return ParseError.NotANumber; }
    
    var res : u64 = 0;

    for i, c in a {
        if c < '0' or c > '9' { 
            if i == 0 { return ParseError.NotANumber; }
            break; // end of number
        }
        const digit = (c - '0') as u64;
        if res > (u64::max - digit) / 10 {
            return ParseError.Overeflow;
        }

        res = 10 * res + digit;
    }

    return res;
}

fn parseU32(a : []const u8) : union { u32, ParseError } {
    var tmp : u64 = parseU64(a) else return;
    if tmp > u32::max { return ParseError.Overeflow; }
    return tmp as u32;
}

fn parseU16(a : []const u8) : union { u16, ParseError } {
    var tmp : u64 = parseU64(a) else return;
    if tmp > u16::max { return ParseError.Overeflow; }
    return tmp as u16;
}

fn parseU8(a : []const u8) : union { u8, ParseError } {
    var tmp : u64 = parseU64(a) else return;
    if tmp > u8::max { return ParseError.Overeflow; }
    return tmp as u8;
}


struct String {
	buffer : [64]u8;
	slice : []const u8;
}

fn integerToString(val : $T) : String {
	var res : String = undefined;
	var n : u64 = 0;
	var negative = false;
	match T::kind {
		case .I8, .I16, .I32, .I64, .ISize:
			negative = val < 0;
			if negative {
				// Convert through u64 so i64::min is handled without overflow.
				n = (0 as u64) - (val as u64);
			} else {
				n = val as u64;
			}
		case .U8, .U16, .U32, .U64:
			n = val as u64;
		case:
			panic("integerToString requires an integer type");
	}
	var pos : i32 = 63;
	if n == 0 {
		res.buffer[pos] = '0';
		pos -= 1;
	} else {
		while n > 0 {
			res.buffer[pos] = ('0' + (n % 10)) as u8;
			pos -= 1;
			n /= 10;
		}
	}
	if negative {
		res.buffer[pos] = '-';
		pos -= 1;
	}
	res.slice = res.buffer[pos + 1:];
	return res;
}

// Formats value with `decimals` digits after the point (at most 9, rounded half up) into buffer and returns the
// part of the buffer that was written. buffer must have at least 32 bytes. NaN is "nan", values that do not fit
// into a 64 bit integer after scaling (including infinities) are "big" or "-big".
fn formatFloat(buffer : []u8, value : f64, decimals : u32) : []const u8 {
	if buffer.length < 32 { panic("formatFloat requires a buffer of at least 32 bytes"); }
	if value != value { return copyText(buffer, "nan"); }

	var places : u32 = decimals > 9 ? 9 : decimals;
	var scale : f64 = 1.0;
	var i : u32 = 0;
	while i < places {
		scale *= 10.0;
		i += 1;
	}

	const magnitude : f64 = value < 0.0 ? 0.0 - value : value;
	const scaled : f64 = magnitude * scale + 0.5;
	if scaled >= 9000000000000000000.0 { return copyText(buffer, value < 0.0 ? "-big" : "big"); }

	var n : u64 = scaled as u64;
	// no "-0.00" for small negative values that round to zero
	const negative = value < 0.0 and n != 0;
	var pos : isize = buffer.length - 1;
	i = 0;
	while i < places {
		buffer[pos] = ('0' + (n % 10)) as u8;
		pos -= 1;
		n /= 10;
		i += 1;
	}
	if places > 0 {
		buffer[pos] = '.';
		pos -= 1;
	}
	if n == 0 {
		buffer[pos] = '0';
		pos -= 1;
	} else {
		while n > 0 {
			buffer[pos] = ('0' + (n % 10)) as u8;
			pos -= 1;
			n /= 10;
		}
	}
	if negative {
		buffer[pos] = '-';
		pos -= 1;
	}
	return buffer[pos + 1:];
}

fn copyText(buffer : []u8, text : []const u8) : []const u8 {
	for i in 0..text.length {
		buffer[i] = text[i];
	}
	return buffer[0:text.length];
}

