[style] {
	.button {
		bg-color: #aaaaaa;
		width: 10em;
		padding: 0.2em;
		margin: 0.2em;
		align: center;
	}
	.button:hover {
		bg-color: #cccccc;
	}
	.world {
		bg-color: #343d51;
		width: 15em;
		padding: 0.25em;
		margin: 0.07em;
		align: center;
	}
	.world:hover { bg-color: #637ba0; }
}

[box $world_menu position=top-right left=100% top=0 direction=column width=17em
	padding=0.5em bg-color=#242d40 color=#ffffff
	font="/engine/editor/fonts/JetBrainsMono-Regular.ttf" font-size=20] {
	[box padding=0.3em font-size=26] { Main menu }
	[box .world on-click=main] { Main menu }
	[box .world on-click=resume] { Resume game }
	[box .world on-click=demo] { Demo }
	[box .world on-click=lightning] { Lightning }
	[box .world on-click=particles] { Particles }
	[box .world on-click=navigation_stress_test] { Navigation stress test }
	[box .world on-click=navigation_stress_test2] { Navigation stress test 2 }
	[box .world on-click=terrain_test] { Terrain test }
	[box .world on-click=point_light_shadows] { Point light shadows }
	[box .world on-click=physics_stress_test] { Physics stress test }
	[box .world on-click=instanced_models] { Instanced models }
	[box .world on-click=anim_stress_test] { Animation stress test }
}

[box $demo_welcome width=100% height=100% align-items=center justify-content=center] {
	[box direction=column width=30em 
		bg-color=#f0f0f0 
		font="/engine/editor/fonts/JetBrainsMono-Regular.ttf" 
		font-size=40
		align-items=stretch
		padding=1.5em
	] {
	    [box direction=row justify-content=center align-items=center] {
	        [box padding-right=0.3em] { Welcome to }
	        [canvas width=36 height=47 margin-left=0.3em margin-right=0.05em] {
	            [path filled=true] {
	                0.0,39.6#fa2d09 3.8,38.7#f93209 7.2,38.1#f93509 10.3,37.7#f83708 
	                13.1,37.5#f83808 15.7,37.5#f83808 18.1,37.7#f83708 20.4,38.1#f93509 
	                22.4,38.6#f93309 24.4,39.2#f92f09 26.2,39.9#fa2c09 26.2,39.9#fa2c09 
	                26.1,39.9#fa2c09 26.0,40.0#fa2b09 25.9,40.2#fa2a09 25.7,40.5#fa2809 
	                25.3,41.1#fb2509 24.9,41.9#fb2109 24.4,43.0#fc1c0a 23.8,44.4#fd140a 
	                23.1,46.2#ff0b0b 23.4,46.1#fe0b0a 24.2,45.6#fe0e0a 25.4,44.9#fe110a 
	                26.8,44.0#fd160a 28.5,42.8#fc1d0a 30.2,41.3#fb2409 31.8,39.7#fa2d09 
	                33.3,37.9#f93609 34.6,35.9#f74108 35.5,33.7#f64c08 32.5,33.2#f54f07 
	                29.6,32.7#f55107 27.0,32.3#f55307 24.5,32.0#f45507 22.1,31.8#f45607 
	                19.9,31.7#f45607 17.7,31.8#f45607 15.6,31.9#f45507 13.6,32.2#f45407 
	                11.6,32.6#f55207 20.3,0.0#defd00 
	            }
	        }
	        [box font-size=60 color=#ff0000] { umix }
	        [box padding-left=0.3em] { Demo }
	    }
	    [box padding=0.5em align-items=center align=center] {
	        [box .button on-click=start] { Start Demo }
	    }
	    [box align=center] {
	        Press W, A, S, D to move. Use mouse to look around.
	
	    }
	}
}

[box $runtime_ui
	font="/engine/editor/fonts/JetBrainsMono-Regular.ttf"
	font-size=30
	width=50%
	height=50%
	margin=25%
	bg-color=#ffFFff
	justify-content=center
	align-items=center
	visible=false
] {
	[box .button on-click=close] { Press to close }
}

