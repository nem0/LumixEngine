import "core:world" as world
import "core:input" as input
import "core:inputdevicetype" as input_device_type
import "core:entity" as entity
import "core:animator"
import "core:physical_controller" as controller
import "core:rigid_actor" as rigid_actor
import "core:physics"
import "core:Keycode"
import "core:quat" as quat
import "core:vec3" as vec3
import "std:math" as math

var player : ?entity.Entity = null;
var camera_pivot : ?entity.Entity = null;
var forward : bool = false;
var backward : bool = false;
var left : bool = false;
var right : bool = false;
var yaw : f32 = 0.0;
var pitch : f32 = 0.0;
var sprint : bool = false;
var speed_input_idx : i32 = -1;
var falling_input_idx : i32 = -1;
var aiming_input_idx : i32 = -1;
var dir_input_idx : i32 = -1;
var stance_input_idx : i32 = -1;
var crouched : bool = false;
var aiming : bool = false;
var handle_input : bool = true;
var input_system : input.InputSystem = undefined;
var physics_module : ?physics.PhysicsModule = null;

fn processInputEvents() : void {
	if not handle_input { return; }

	const event_count = input_system.getEventCount();
	for i = 0..event_count {
		const event = input_system.getEvent(i);
		match event {
			case AxisEvent:
				if event.device_type == .MOUSE {
					yaw = yaw + event.x * -0.01;
					pitch = pitch + event.y * -0.01;
				}
			case ButtonEvent:
				if event.device_type == .MOUSE {
					aiming = event.down and event.key_id == 1;
				}
				if event.device_type == .KEYBOARD {
					match event.key_id as Keycode {
						case .W: forward = event.down;
						case .S: backward = event.down;
						case .A: left = event.down;
						case .D: right = event.down;
						case .SHIFT: sprint = event.down;
						case .C: {
							if event.down {
								crouched = not crouched;
							}
						}
						case:
					}
				}
			case:
		}
	}
}

fn init(w : world.World, inp : input.InputSystem) : void {
	player = w.findByName("player");
	// camera_pivot = TODO
	input_system = inp;
	physics_module = w.physics();

	if player != null {
		const anim = player.animator();
		if anim != null {
			speed_input_idx = anim.getInputIndex("speed_y");
			dir_input_idx = anim.getInputIndex("speed_x");
			stance_input_idx = anim.getInputIndex("stance");
			falling_input_idx = anim.getInputIndex("is_falling");
			aiming_input_idx = anim.getInputIndex("is_aiming");
		}
	}
}

fn update(dt : f32) : void {
	processInputEvents();

	if physics_module != null {
		const num_hits = physics_module.getNumControllerHits();
		for i = 0..num_hits {
			const hit = physics_module.getControllerHit(i);
			const obj = hit.hit_entity;
			const a = obj.rigid_actor();
			if a != null {
				const force = vec3.yawToDir(yaw) * 50.0;
				a.applyForce(force);
			}
		}
	}

	const anim = player.animator();
	if anim == null { return; }

	if speed_input_idx == -1 {
		speed_input_idx = anim.getInputIndex("speed_y");
		dir_input_idx = anim.getInputIndex("speed_x");
		stance_input_idx = anim.getInputIndex("stance");
		falling_input_idx = anim.getInputIndex("is_falling");
		aiming_input_idx = anim.getInputIndex("is_aiming");
	}

	if pitch < -0.9 { pitch = -0.9; }
	if pitch > 0.9 { pitch = 0.9; }

	const phys_controller = player.physical_controller();
	var gravity_speed : f32 = 0.0;
	if phys_controller != null {
		gravity_speed = phys_controller.getGravitySpeed();
	}

	var speed_y : f32 = forward ? 3.0 :
						backward ? -3.0 :
						0;

	var speed_x : f32 = left ? -3.0 :
						right ? 3.0 :
						0;
	if sprint {
		speed_x = speed_x * 2.0;
		speed_y = speed_y * 2.0;
	}

	anim.setFloatInput(speed_input_idx, speed_y);
	anim.setFloatInput(dir_input_idx, speed_x);

	anim.setFloatInput(stance_input_idx, crouched ? 1.0 : 0.0);

	anim.setBoolInput(falling_input_idx, gravity_speed < -4.0);
	anim.setBoolInput(aiming_input_idx, aiming);

	const yaw_rot = quat.makeQuatFromYaw(yaw);
	const pitch_rot = quat.makeQuatFromPitch(pitch);
	player.setRotation(yaw_rot);

	if camera_pivot != null {
		camera_pivot.setRotation(yaw_rot * pitch_rot);
	}
}
