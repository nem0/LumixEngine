import "core:input"
import "core:world"
import "core:log"
import "core:random"
import "core:string"
import "core:ui"

import "scripts/player" as player
import "maps/demo/demo" as demo
import "maps/particles/lightning" as lightning
import "maps/particles/move" as particle_move
import "maps/particles/clutter_sphere" as clutter_sphere

var g_input : InputSystem = undefined;
var g_world : ?World = null;

enum WorldType {
	NONE,
	MAIN,
	DEMO,
	LIGHTNING,
	PARTICLES,
}

var world_type : WorldType = .NONE;
fn await(r : LoadRequest) : void {
	while r.getStatus() == .PENDING {
		const dt : f32 = yield;
	}
}

fn main(input : InputSystem, world : World) : void {
	g_input = input;
	g_world = world;

	player.init(world, input);

	for i in 0..world.getPartitionCount() {
		const handle = world.getPartitionHandle(i);
		const name = world.getPartitionName(handle);
		if endsWith(name, "main.unv") {
			world_type = .MAIN;
			break;
		}
		if endsWith(name, "demo.unv") {
			world_type = .DEMO;
			demo.start(world);
			player.init(world, g_input);
			break;
		}
		if endsWith(name, "lightning.unv") {
			const source_value = world.findByName("core");
			if const source = source_value {
				world_type = .LIGHTNING;
				lightning.start(world, source);
			}
			break;
		}
		if endsWith(name, "particles.unv") {
			const moving = world.findByName("world_space_particle");
			const clutter = world.findByName("clutter");
			if const moving_entity = moving {
				if const clutter_entity = clutter {
					if const clutter_child = clutter_entity.getFirstChild() {
						world_type = .PARTICLES;
						particle_move.start(moving_entity);
						clutter_sphere.start(clutter_child, clutter_entity);
					}
				}
			}
			break;
		}
	}

	while true {
		const dt : f32 = yield;
		player.update(dt);

		match world_type {
			case .NONE:
			case .MAIN:
				for event in g_input.getEvents() {
					match event {
						case ButtonEvent:
							if event.device_type == .KEYBOARD {
								var request = world.load("maps/demo/demo.unv");
								defer request.destroy();

								await(request);

								if request.getStatus() == .SUCCESS {
									if const ui = world.ui() {
										ui.load("maps/demo/demo.ui");
									}
									else {
										panic("Missing UI");
									}
									demo.start(world);
									player.init(world, g_input);
									world_type = .DEMO;
								}
								else {
									logError(`Failed to load maps/demo/demo.unv: {request.getError()}`); 
								}
							}
						case:
					}
				}
			case .DEMO: demo.update(dt, g_input);
			case .LIGHTNING: lightning.update(dt);
			case .PARTICLES:
				particle_move.update(dt);
				clutter_sphere.update(dt);
		}
	}
}

