import "core:input"
import "core:world"
import "core:random"
import "core:string"

import "scripts/player" as player
import "maps/demo/demo" as demo
import "maps/particles/lightning" as lightning
import "maps/particles/move" as particle_move
import "maps/particles/clutter_sphere" as clutter_sphere

var g_input : InputSystem = undefined;
var g_world : World = undefined;

enum WorldType {
	DEMO,
	LIGHTNING,
	PARTICLES,
}

var world_type : WorldType = .DEMO;

fn start(input : InputSystem) : void {
	g_input = input;

	for i in 0..g_world.getPartitionCount() {
		const handle = g_world.getPartitionHandle(i);
		const name = g_world.getPartitionName(handle);
		if endsWith(name, "demo.unv") {
			world_type = .DEMO;
			demo.start(g_world);
			player.init(g_world, g_input);
			break;
		}
		if endsWith(name, "lightning.unv") {
			const source_value = g_world.findByName("core");
			if const source = source_value {
				world_type = .LIGHTNING;
				lightning.start(g_world, source);
			}
			break;
		}
		if endsWith(name, "particles.unv") {
			const moving = g_world.findByName("world_space_particle");
			const clutter = g_world.findByName("clutter");
			if const moving_entity = moving {
				if const clutter_entity = clutter {
					if const clutter_child = clutter_entity.getFirstChild() {
						world_type = .PARTICLES;
						particle_move.start(moving_entity);
						clutter_sphere.start(clutter_child, clutter_entity);
					}
				}
			}
			break;
		}
	}
}

fn update(td : f32) : void {
	match world_type {
		case .DEMO: demo.update(td, g_input);
		case .LIGHTNING: lightning.update(td);
		case .PARTICLES:
			particle_move.update(td);
			clutter_sphere.update(td);
	}
}

fn addWorld(world : World) : void {
	g_world = world;
}
