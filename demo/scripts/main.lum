import "core:input"
import "core:log"
import "core:ui"
import "core:document"
import "core:world"

import "scripts/player" as player

var g_input : InputSystem = undefined;
var g_world : World = undefined;

fn update(td : f32) : void {
    player.update(td);
	
	// UI
	var ui = g_world.ui();
	//var events = g_world.ui()?.getDocument()?.getEvents();
	if ui != null {
		var doc = ui.getDocument();
		if doc != null {
			var events = doc.getEvents();
			for event in events {
				if event.action == "start" {
					player.handle_input = true;
					var root_el = doc.getElement(0);
					if root_el != null {
						root_el.setVisible(false);
					}
				}
				else if event.action == "close" {
					var el = doc.getElementByID("runtime_ui");
					if el != null {
						el.setVisible(false);
					}
				}
			}	
		}
	}
}

fn init(input : InputSystem) : void {
	g_input = input;
}

fn addWorld(world : World) : void {
	g_world = world;
	player.init(world, g_input);
}
