struct Color {
	r : u8;
	g : u8;
	b : u8;
	a : u8;
}

enum RaylibKey {
	Enter = 257,
	Right = 262,
	Left = 263,
	Down = 264,
	Up = 265
}

extern fn InitWindow(width : i32, height : i32, title : cstr) : void;
extern fn SetTargetFPS(fps : i32) : void;
extern fn WindowShouldClose() : bool;
extern fn IsKeyDown(key : i32) : bool;
extern fn IsKeyPressed(key : i32) : bool;
extern fn BeginDrawing() : void;
extern fn EndDrawing() : void;
extern fn CloseWindow() : void;
extern fn ClearBackground(c : Color) : void;
extern fn DrawRectangle(x : i32, y : i32, width : i32, height : i32, c : Color) : void;
extern fn DrawRectangleLines(x : i32, y : i32, width : i32, height : i32, c : Color) : void;
extern fn DrawText(text : cstr, x : i32, y : i32, size : i32, c : Color) : void;

const board_width : i32 = 10;
const board_height : i32 = 20;
const cell_size : i32 = 32;
const board_left : i32 = 40;
const board_top : i32 = 40;

var board : [200]i32 = undefined;
var piece : [16]i32 = undefined;
var piece_x : i32 = 3;
var piece_y : i32 = 0;
var piece_kind : i32 = 0;
var score : i32 = 0;
var game_over : bool = false;

fn set_piece_shape() : void {
	for i in 0..16 {
		piece[i] = 0;
	}

	match piece_kind {
		case 0:
			piece[4] = 1;
			piece[5] = 1;
			piece[6] = 1;
			piece[7] = 1;
		case 1:
			piece[1] = 1;
			piece[2] = 1;
			piece[5] = 1;
			piece[6] = 1;
		case 2:
			piece[1] = 1;
			piece[4] = 1;
			piece[5] = 1;
			piece[6] = 1;
		case 3:
			piece[1] = 1;
			piece[2] = 1;
			piece[4] = 1;
			piece[5] = 1;
		case 4:
			piece[0] = 1;
			piece[1] = 1;
			piece[5] = 1;
			piece[6] = 1;
		case 5:
			piece[0] = 1;
			piece[4] = 1;
			piece[5] = 1;
			piece[6] = 1;
		else:
			piece[2] = 1;
			piece[4] = 1;
			piece[5] = 1;
			piece[6] = 1;
	}
}

fn can_move(dx : i32, dy : i32) : bool {
	for i in 0..16 {
		if piece[i] != 0 {
			const local_x = i % 4;
			const local_y = i / 4;
			const x = piece_x + local_x + dx;
			const y = piece_y + local_y + dy;
			if x < 0 or x >= board_width or y >= board_height {
				return false;
			}
			if y >= 0 {
				if board[x + y * board_width] != 0 {
					return false;
				}
			}
		}
	}
	return true;
}

fn rotate_piece() : void {
	var rotated : [16]i32 = undefined;
	for y in 0..4 {
		for x in 0..4 {
			rotated[x * 4 + (3 - y)] = piece[y * 4 + x];
		}
	}

	for i in 0..16 {
		piece[i] = rotated[i];
	}
}

fn spawn_piece() : void {
	piece_x = 3;
	piece_y = 0;
	piece_kind = (piece_kind + 1) % 7;
	set_piece_shape();
	if not can_move(0, 0) {
		game_over = true;
	}
}

fn lock_piece() : void {
	for i in 0..16 {
		if piece[i] != 0 {
			const x = piece_x + (i % 4);
			const y = piece_y + (i / 4);
			if y >= 0 and y < board_height {
				board[x + y * board_width] = piece_kind + 1;
			}
		}
	}
}

fn clear_lines() : void {
	var y = board_height - 1;
	while y >= 0 {
		var full = true;
		for x in 0..10 {
			if board[x + y * board_width] == 0 {
				full = false;
			}
		}

		if not full {
			y -= 1;
			continue;
		}

		var row = y;
		while row > 0 {
			for x in 0..10 {
				board[x + row * board_width] = board[x + (row - 1) * board_width];
			}
			row -= 1;
		}
		for x in 0..10 {
			board[x] = 0;
		}
		score += 100;
	}
}

fn draw_block(x : i32, y : i32, kind : i32) : void {
	var color : Color = { 80, 80, 80, 255 };
	match kind {
		case 1:
			color = { 40, 190, 220, 255 };
		case 2:
			color = { 240, 220, 50, 255 };
		case 3:
			color = { 170, 70, 220, 255 };
		case 4:
			color = { 60, 190, 80, 255 };
		case 5:
			color = { 220, 60, 60, 255 };
		case 6:
			color = { 60, 100, 220, 255 };
		case 7:
			color = { 230, 140, 40, 255 };
		else:
			color = { 80, 80, 80, 255 };
	}
	DrawRectangle(board_left + x * cell_size, board_top + y * cell_size, cell_size - 1, cell_size - 1, color);
}

fn draw_game() : void {
	for x in 0..10 {
		for y in 0..20 {
			const value = board[x + y * board_width];
			if value != 0 {
				draw_block(x, y, value);
			}
		}
	}

	for i in 0..16 {
		if piece[i] != 0 {
			draw_block(piece_x + (i % 4), piece_y + (i / 4), piece_kind + 1);
		}
	}

	DrawRectangleLines(board_left - 2, board_top - 2, board_width * cell_size + 3, board_height * cell_size + 3, { 30, 30, 30, 255 });
	DrawText("LUMSCRIPT TETRIS", 420, 55, 24, { 30, 30, 30, 255 });
	DrawText("Arrows: move / Up: rotate / Down: drop", 420, 90, 18, { 50, 50, 50, 255 });
	DrawText("Score:", 420, 125, 20, { 50, 50, 50, 255 });
	if game_over {
		DrawText("GAME OVER", 420, 210, 32, { 220, 50, 50, 255 });
		DrawText("Press Enter to restart", 420, 250, 20, { 50, 50, 50, 255 });
	}
}

fn reset_game() : void {
	for i in 0..200 {
		board[i] = 0;
	}
	score = 0;
	game_over = false;
	piece_kind = -1;
	spawn_piece();
}

fn main() : i32 {
	InitWindow(1200, 820, "LumScript Tetris");
	SetTargetFPS(60);
	reset_game();

	var gravity : i32 = 0;
	while not WindowShouldClose() {
		if game_over {
			if IsKeyPressed(RaylibKey.Enter as i32) {
				reset_game();
			}
		}
		else {
			if IsKeyPressed(RaylibKey.Left as i32) {
				if can_move(-1, 0) {
					piece_x -= 1;
				}
			}
			if IsKeyPressed(RaylibKey.Right as i32) {
				if can_move(1, 0) {
					piece_x += 1;
				}
			}
			if IsKeyPressed(RaylibKey.Up as i32) {
				rotate_piece();
				if not can_move(0, 0) {
					rotate_piece();
					rotate_piece();
					rotate_piece();
				}
			}
			if IsKeyDown(RaylibKey.Down as i32) {
				gravity = 30;
			}
			gravity += 1;
			if gravity >= 30 {
				gravity = 0;
				if can_move(0, 1) {
					piece_y += 1;
				}
				else {
					lock_piece();
					clear_lines();
					spawn_piece();
				}
			}
		}

		BeginDrawing();
		ClearBackground({ 245, 245, 245, 255 });
		draw_game();
		EndDrawing();
	}

	CloseWindow();
	return 0;
}
